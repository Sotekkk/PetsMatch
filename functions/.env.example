# Modèle de configuration des Cloud Functions (voir config.js).
# Copier en .env.<projectId> (ex. .env.petsmatch-eb96d pour la prod) — ces
# fichiers ne sont PAS versionnés. Le CLI Firebase charge celui du projet
# ciblé par `firebase deploy` / `firebase use`.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<clé secrète Supabase (Settings → API Keys)>
STRIPE_SECRET_KEY=<sk_test_… en staging, sk_live_… en prod>
# Même valeur que INTERNAL_API_SECRET dans les variables d'environnement du site
INTERNAL_API_SECRET=<chaîne aléatoire longue>

